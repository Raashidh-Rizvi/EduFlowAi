[TEMPLATE]
# ==============================================================================
# EduFlow AI - Global Environment Variable Reference & Template
# ==============================================================================
# This file provides an overview of all configurable environment variables
# used across the EduFlow AI platform (Backend API, AI Agent, React Frontend).
#
# RULES:
#   - Placeholders only. NEVER put a real API key, token, or password here.
#   - Real values live in ai-agent/.env and appsettings.*.json, which are
#     git-ignored. API keys stay server-side and are never sent to the browser.
#   - Every variable below is read by the code; names in <alias> comments are
#     accepted alternative spellings.

# ------------------------------------------------------------------------------
# 1. Backend API (backend/EduFlow.Api/appsettings.Development.json)
# ------------------------------------------------------------------------------
# ConnectionStrings__DefaultConnection="Host=localhost;Database=EduFlowDb;Username=postgres;Password=<postgres-password>"
# Redis__ConnectionString="localhost:6379"
# JwtSettings__Secret="<generate-a-long-random-secret; 256 bits minimum>"
# AiService__BaseUrl="http://localhost:8000"
# AiService__ApiKey="<generate-a-random-token; must match ai-agent INTERNAL_SERVICE_TOKEN>"

# ------------------------------------------------------------------------------
# 2. AI Agent Microservice (ai-agent/.env)
# ------------------------------------------------------------------------------

# --- Active quiz provider / model ------------------------------------------------
# QUIZ_LLM_PROVIDER selects the default provider when a request does not pick one.
# Per-request selection (instructor UI or API payload) wins over this default.
# QUIZ_LLM_PROVIDER="gemini"   # gemini | groq | azure   (alias: AI_PROVIDER)
# QUIZ_LLM_MODEL=""            # optional default model / Azure deployment (alias: AI_MODEL)

# --- Gemini / Google ------------------------------------------------------------
# GEMINI_API_KEY=""            # alias: GOOGLE_API_KEY
# GEMINI_MODEL="models/gemini-flash-latest"
# GEMINI_MODELS=""             # optional comma-separated server-side allowlist

# --- Groq -----------------------------------------------------------------------
# GROQ_API_KEY=""
# GROQ_MODEL="openai/gpt-oss-120b"
# GROQ_MODELS=""               # optional comma-separated server-side allowlist

# --- Azure OpenAI ---------------------------------------------------------------
# AZURE_OPENAI_API_KEY=""
# AZURE_OPENAI_ENDPOINT="https://your-resource-name.openai.azure.com/"
# AZURE_OPENAI_BASE_URL=""     # alternative to AZURE_OPENAI_ENDPOINT (plain OpenAI protocol)
# AZURE_OPENAI_API_VERSION="2024-02-01"
# AZURE_OPENAI_CHAT_DEPLOYMENT=""   # alias: AZURE_OPENAI_DEPLOYMENT
# AZURE_OPENAI_MODELS=""            # optional comma-separated allowlist of deployments
# AZURE_AI_PROJECT_ENDPOINT="https://your-resource-name.services.ai.azure.com/"
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT="text-embedding-3-small"

# --- Other (learning agent / legacy paths) --------------------------------------
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"
# INTERNAL_SERVICE_TOKEN="<generate-a-random-token; must match backend AiService:ApiKey>"
# INTERNAL_AUTH_FAIL_OPEN="false"   # keep false in production
# EDUFLOW_BACKEND_URL="http://localhost:5204"

# --- Embeddings (RAG indexing) ---------------------------------------------------
# EMBEDDING_PROVIDER="default"   # default (local ONNX all-MiniLM-L6-v2) | gemini
# EMBEDDING_MODEL=""             # e.g. models/gemini-embedding-001 when provider=gemini
# EMBEDDING_VERSION="v1"         # bump when the embedding model changes -> triggers reindex advice

# --- RAG retrieval tuning ---------------------------------------------------------
# RAG_QUIZ_TOP_K="8"             # chunks retrieved to ground a generated quiz
# RAG_QUIZ_MIN_SIMILARITY="0.2"  # minimum similarity for a chunk to count as context
# RAG_RELEVANCE_THRESHOLD="0.45" # chat answer relevance threshold
# CHROMA_PERSIST_DIR=""          # override the default vector store directory
# LLM_PROVIDER="gemini"          # learning-agent chat provider (gemini | groq)

# ------------------------------------------------------------------------------
# 3. React Frontend (frontend/.env)
# ------------------------------------------------------------------------------
# The frontend only ever receives the API origin — no AI keys, ever.
# VITE_API_BASE_URL="http://localhost:5204/api"
