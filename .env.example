# ==============================================================================
# EduFlow AI - Global Environment Variable Reference & Template
# ==============================================================================
# This file provides an overview of all configurable environment variables 
# used across the EduFlow AI platform (Backend API, AI Agent, React Frontend).

# ------------------------------------------------------------------------------
# 1. Backend API (backend/EduFlow.Api/appsettings.Development.json)
# ------------------------------------------------------------------------------
# ConnectionStrings__DefaultConnection="Host=localhost;Database=EduFlowDb;Username=postgres;Password=postgres"
# Redis__ConnectionString="localhost:6379"
# JwtSettings__Secret="EduFlowSuperSecretKeyForDevelopmentPurposes2026!WithMinimum256BitsLengthRequirements"
# AiService__BaseUrl="http://localhost:8000"
# AiService__ApiKey="eduflow-local-dev-internal-token-2026"

# ------------------------------------------------------------------------------
# 2. AI Agent Microservice (ai-agent/.env)
# ------------------------------------------------------------------------------
# AZURE_OPENAI_API_KEY="your_azure_openai_api_key"
# AZURE_OPENAI_ENDPOINT="https://your-resource-name.openai.azure.com/"
# AZURE_OPENAI_BASE_URL="https://your-resource-name.openai.azure.com/"
# AZURE_AI_PROJECT_ENDPOINT="https://your-resource-name.services.ai.azure.com/"
# AZURE_OPENAI_API_VERSION="2024-02-01"
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT="text-embedding-3-small"
# AZURE_OPENAI_CHAT_DEPLOYMENT="gpt-4o"
# GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-3.5-flash"
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"
# GROQ_API_KEY=""
# INTERNAL_SERVICE_TOKEN="eduflow-local-dev-internal-token-2026"
# INTERNAL_AUTH_FAIL_OPEN="true"
# EDUFLOW_BACKEND_URL="http://localhost:5204"

# ------------------------------------------------------------------------------
# 3. React Frontend (frontend/.env)
# ------------------------------------------------------------------------------
# VITE_API_BASE_URL="http://localhost:5204/api"
