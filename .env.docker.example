# EduFlow AI - docker-compose secrets
# Copy to `.env` (git-ignored) next to docker-compose.yml and fill in real values.
# AI provider keys (Gemini / Groq / Azure) go in ai-agent/.env as before.

# Public port Nginx listens on
HTTP_PORT=80

# PostgreSQL
POSTGRES_DB=EduFlowDb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<strong-random-password>

# JWT signing key - at least 32 characters (e.g. `openssl rand -base64 48`)
JWT_SECRET=<long-random-secret>

# Shared backend <-> ai-agent token (e.g. `openssl rand -hex 32`)
INTERNAL_SERVICE_TOKEN=<random-token>

# Provision the demo admin account on startup
DEMO_ACCOUNTS_ENABLED=false
