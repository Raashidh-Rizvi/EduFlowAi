{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "buildCommand": "VITE_API_BASE_URL=/api npm run build",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "ai-agent": {
      "root": "ai-agent",
      "framework": "fastapi",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "http://159.13.63.98/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "http://159.13.63.98/uploads/$1"
    },
    {
      "source": "/health",
      "destination": "http://159.13.63.98/health"
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
