# EduFlow AI - Simple RAG Configuration Example
INTERNAL_SERVICE_TOKEN=internal_ai_gateway_secret_token

# =============================================================================
# 1. EMBEDDINGS STRATEGY (Vector Storage & Search in ChromaDB)
# Options: "default" | "gemini"
# =============================================================================
EMBEDDING_PROVIDER=default

# =============================================================================
# 2. CHATBOT LLM STRATEGY (Student Question Answering)
# Options: "gemini" | "groq"
# =============================================================================
LLM_PROVIDER=gemini

# ==============================================================================
# Google Gemini Credentials
# ==============================================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ==============================================================================
# Groq Credentials (Ultra-fast LPU inference)
# ==============================================================================
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ChromaDB Vector Storage Directory
CHROMA_PERSIST_DIR=./data/chroma_db

# ==============================================================================
# Microservice Security & System Parameters
# ==============================================================================
# MUST match AiService:ApiKey in backend appsettings.json
INTERNAL_SERVICE_TOKEN=eduflow-local-dev-internal-token-2026

# Set to "true" only for local development/CI where the token is not configured.
INTERNAL_AUTH_FAIL_OPEN=false

# LLM request timeout in seconds (default: 60)
LLM_TIMEOUT_SECONDS=60

# Backend URL for tool registry calls (default: http://localhost:5204)
EDUFLOW_BACKEND_URL=http://localhost:5204
