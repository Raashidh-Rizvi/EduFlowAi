# EduFlow AI - Simple RAG Configuration Example
INTERNAL_SERVICE_TOKEN=internal_ai_gateway_secret_token

# =============================================================================
# 1. EMBEDDINGS STRATEGY (Vector Storage & Search in ChromaDB)
# Options: "default" | "gemini"
# =============================================================================
EMBEDDING_PROVIDER=default

# =============================================================================
# 2. CHATBOT LLM STRATEGY (Student Question Answering)
# Options: "gemini" | "groq"
# =============================================================================
LLM_PROVIDER=gemini

# --- API KEYS ---
# Google Gemini API Key (Get free key: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Groq API Key (Get free key: https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ChromaDB Vector Storage Directory
CHROMA_PERSIST_DIR=./data/chroma_db
