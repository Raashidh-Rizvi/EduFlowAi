# EduFlow AI - Simple RAG Configuration
# Shared secret required in X-Internal-Api-Key on every route except /health.
# Must equal the backend AiService:ApiKey. Generate a long random value.
INTERNAL_SERVICE_TOKEN=
# Local dev only: accept unauthenticated calls when INTERNAL_SERVICE_TOKEN is empty.
INTERNAL_AUTH_FAIL_OPEN=false
# Comma-separated CORS origins (default: http://localhost:5173,http://localhost:5204)
ALLOWED_ORIGINS=
# Comma-separated directories file paths must live under (default: backend/EduFlow.Api/wwwroot/uploads)
UPLOADS_ROOT=
# Optional web-search fallback for RAG chat
TAVILY_API_KEY=
ENABLE_WEB_SEARCH_FALLBACK=true
RAG_RELEVANCE_THRESHOLD=0.45

# =============================================================================
# 1. EMBEDDINGS STRATEGY (Vector Storage & Search in ChromaDB)
# Options:
#   - "default": Local ONNX (all-MiniLM-L6-v2) - 100% offline, zero RAM, zero key
#   - "gemini" : Google gemini-embedding-001 - Large vocabulary cloud model (Zero RAM)
# =============================================================================
EMBEDDING_PROVIDER=gemini

# =============================================================================
# 2. CHATBOT LLM STRATEGY (Student Question Answering)
# Options:
#   - "gemini": Google Gemini 1.5 Flash (Huge context window, high reasoning)
#   - "groq"  : Groq LPU with Llama 3.3 70B (Ultra-fast <0.4s instant responses)
# =============================================================================
LLM_PROVIDER=groq

# --- API KEYS ---
# Google Gemini API Key (Get free key from: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=models/gemini-flash-latest

# Groq API Key (Get free key from: https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Azure OpenAI (Azure AI Foundry -> your resource -> Keys and Endpoint / Deployments)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
# Optional alternative to AZURE_OPENAI_ENDPOINT (OpenAI-compatible v1 endpoint)
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_API_VERSION=2024-10-21
# Name of your *chat* model deployment (e.g. gpt-4o-mini), not the model family name
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# =============================================================================
# QUIZ GENERATOR LLM
# QUIZ_LLM_PROVIDER: gemini | groq | azure   (default: gemini)
#   gemini -> uses GEMINI_API_KEY + GEMINI_MODEL
#   groq   -> uses GROQ_API_KEY + GROQ_MODEL
#   azure  -> uses AZURE_OPENAI_* above + AZURE_OPENAI_CHAT_DEPLOYMENT
# QUIZ_LLM_MODEL: optional override of the model / Azure deployment name
# Restart the AI service after changing these.
# =============================================================================
QUIZ_LLM_PROVIDER=gemini
QUIZ_LLM_MODEL=

# ChromaDB Vector Storage Directory
CHROMA_PERSIST_DIR=./data/chroma_db
# Hosted vector store (needed on Vercel, whose disk is ephemeral). CHROMA_API_KEY wins over
# CHROMA_HOST; with neither set the on-disk store above is used.
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
# CHROMA_HOST=
# CHROMA_PORT=8000
# CHROMA_SSL=false
# Private Vercel Blob store holding course uploads (same token as the backend). When set,
# the backend sends Blob URLs and this service downloads them to a temp dir.
BLOB_READ_WRITE_TOKEN=
