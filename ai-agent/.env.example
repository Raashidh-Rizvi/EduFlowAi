# ==============================================================================
# Azure AI & Azure OpenAI Credentials
# ==============================================================================
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_BASE_URL=https://your-resource-name.openai.azure.com/
AZURE_AI_PROJECT_ENDPOINT=https://your-resource-name.services.ai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o

# ==============================================================================
# Google Gemini Credentials (Optional fallback)
# ==============================================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ==============================================================================
# Standard OpenAI Credentials (Optional fallback)
# ==============================================================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ==============================================================================
# Groq Credentials (Optional fallback)
# ==============================================================================
GROQ_API_KEY=

# ==============================================================================
# Microservice Security & System Parameters
# ==============================================================================
# MUST match AiService:ApiKey in backend appsettings.json
INTERNAL_SERVICE_TOKEN=eduflow-local-dev-internal-token-2026

# Set to "true" only for local development/CI where the token is not configured.
# Default is "false" (fail-closed: requests are rejected with 503 if token unset).
INTERNAL_AUTH_FAIL_OPEN=false

# LLM request timeout in seconds (default: 60)
LLM_TIMEOUT_SECONDS=60

# Backend URL for tool registry calls (default: http://localhost:5204)
EDUFLOW_BACKEND_URL=http://localhost:5204
